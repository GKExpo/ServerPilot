{
  "appId": "com.serverpilotv2.desktop",
  "productName": "ServerPilot V2",
  "asar": true,
  "directories": {
    "output": "dist"
  },
  "files": [
    "electron/**/*",
    "backend/**/*",
    "assets/**/*",
    "storage/**/*",
    "dist-renderer/**/*",
    "package.json"
  ],
  "extraMetadata": {
    "main": "electron/main.js"
  },
  "win": {
    "icon": "assets/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "artifactName": "ServerPilot v${version}-${arch}-${name}.${ext}",
    "requestedExecutionLevel": "asInvoker"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "ServerPilot V2",
    "artifactName": "ServerPilot v${version}-Setup.${ext}"
  },
  "portable": {
    "artifactName": "ServerPilot v${version}-Portable.${ext}"
  }
}
